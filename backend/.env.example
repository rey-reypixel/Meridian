# FastAPI & Server
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# Database (Postgres, via docker-compose service name "postgres")
DATABASE_URL=postgresql+psycopg2://meridian:meridian@postgres:5432/meridian
DATABASE_ASYNC_URL=postgresql+asyncpg://meridian:meridian@postgres:5432/meridian

# Redis (via docker-compose service name "redis")
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
# Dev/test only: skip the real Anthropic call, return a fake completion
# (real token counts still computed via tiktoken). Never set true in prod.
MOCK_ANTHROPIC=false

# OAuth (Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Where /auth/callback (the frontend's own route, not the backend's above)
# redirects to after login (?token=<jwt> appended)
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Optimization Settings
CONTEXT_TRUNCATION_ENABLED=true
MODEL_ROUTING_ENABLED=true
BATCH_PROCESSING_ENABLED=true
QUALITY_THRESHOLD=8.5
CONTEXT_RELEVANCE_THRESHOLD=0.7
PRESERVE_RECENT_MESSAGES=5

# Logging
LOG_LEVEL=INFO
